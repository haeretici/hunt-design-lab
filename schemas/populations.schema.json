{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hunt-design-lab.local/schemas/populations.schema.json",
  "title": "Population table",
  "description": "Shape of presets/<mode>/populations/<id>.json. Loaded by presets.loadPopulation. Storage: folder entity.",
  "type": "object",
  "required": ["id"],
  "additionalProperties": true,
  "definitions": {
    "entityId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,79}$",
      "minLength": 1,
      "maxLength": 80
    },
    "packSize": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "integer", "minimum": 0 }
    },
    "group": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "weight": { "type": "number", "minimum": 0 },
        "creatureIds": {
          "type": "array",
          "description": "Creature template ids (presets/<mode>/creatures/). Designer: Select opens the combat creature browser.",
          "items": {
            "type": "string",
            "format": "creature_id",
            "pattern": "^[a-z][a-z0-9_]{0,79}$",
            "minLength": 1,
            "maxLength": 80,
            "description": "Combat creature template id."
          }
        },
        "packSize": { "$ref": "#/definitions/packSize" },
        "affixes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "properties": {
    "id": { "$ref": "#/definitions/entityId" },
    "label": { "type": "string", "maxLength": 120 },
    "biome": { "type": "string" },
    "notes": { "type": "string", "maxLength": 4000 },
    "defaultRespawn": { "type": "number", "minimum": 0 },
    "groups": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/group" }
    },
    "band": {
      "type": "object",
      "additionalProperties": true,
      "description": "Threat-band metadata for generated populations (docs/24). selected* ranges are derived cache from the last band build.",
      "properties": {
        "levelMin": {
          "type": "integer",
          "minimum": 0,
          "description": "Inclusive threat-rank floor used to pick templates. 0 / omitted = unset (do not invent 1 on Save)."
        },
        "levelMax": {
          "type": "integer",
          "minimum": 0,
          "description": "Inclusive threat-rank ceiling used to pick templates. 0 / omitted = unset."
        },
        "threatMin": {
          "type": "number",
          "minimum": 0,
          "description": "Inclusive threatDps floor."
        },
        "threatMax": {
          "type": ["number", "null"],
          "minimum": 0,
          "description": "Inclusive threatDps ceiling. null = no ceiling."
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "description": "How many templates the band picker selected. 0 / omitted = unset."
        },
        "seed": {
          "type": "integer",
          "description": "Seed used for even-spread template pick."
        },
        "selectedLevelRange": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number" },
          "description": "Derived [min, max] threat rank of the selected templates."
        },
        "selectedThreatRange": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number" },
          "description": "Derived [min, max] threatDps of the selected templates."
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": true,
      "description": "Pack-count caps for resolvePopulation. Each value is [min, max].",
      "properties": {
        "totalPacks": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "integer", "minimum": 0 },
          "description": "Total packs spawned [min, max]."
        },
        "championPacks": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "integer", "minimum": 0 },
          "description": "Champion-group packs [min, max]."
        },
        "elitePacks": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "integer", "minimum": 0 },
          "description": "Elite-group packs [min, max]."
        }
      }
    }
  }
}
