{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hunt-design-lab.local/schemas/parties.schema.json",
  "title": "Party folder entity",
  "description": "Shape of presets/<mode>/parties/<id>.json. Storage: folder entity. Defines party compositions of player base profiles.",
  "type": "object",
  "required": ["id"],
  "additionalProperties": true,
  "definitions": {
    "entityId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,79}$",
      "minLength": 1,
      "maxLength": 80
    }
  },
  "properties": {
    "id": { "$ref": "#/definitions/entityId" },
    "label": {
      "type": "string",
      "maxLength": 120,
      "description": "Human-readable party display name."
    },
    "members": {
      "type": "array",
      "title": "Party Members",
      "description": "Set of Base Profiles forming the party.",
      "items": {
        "type": "object",
        "title": "Member",
        "additionalProperties": true,
        "properties": {
          "profileId": {
            "type": "string",
            "description": "Base profile ID (relation: kind=player_profiles)."
          },
          "name": {
            "type": "string",
            "maxLength": 120,
            "description": "Display name of the party member."
          },
          "isLeader": {
            "type": "boolean",
            "default": false,
            "description": "Whether this member leads party movement."
          },
          "vocation": {
            "type": "string",
            "description": "Class or vocation override (relation: kind=classes)."
          },
          "strategyId": {
            "type": "string",
            "description": "Strategy override ID (relation: kind=strategies)."
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999,
            "description": "Level override for this member."
          },
          "controlMode": {
            "type": "string",
            "enum": ["ai", "manual"],
            "default": "ai",
            "description": "Control mode override for this member."
          },
          "storage": {
            "type": "object",
            "additionalProperties": true,
            "description": "Hunt-scoped scenario KV seed (dialog when / node set). Merged with party/scenario storage. Unset keys read as 0."
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "maxLength": 4000,
      "description": "Designer notes."
    }
  }
}
